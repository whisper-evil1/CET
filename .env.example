# 复制为 .env 后按需修改（.env 已在 .gitignore 里，不会被提交）

# 数据库。本地默认 SQLite 文件库（零依赖，可直接部署）。
# 若要换成托管 PostgreSQL，把上面 DATABASE_URL 换成对应的连接串，
# 并把 prisma/schema.prisma 的 provider 改成 postgresql 即可。
DATABASE_URL="file:./dev.db"

# NextAuth 会话签名密钥。生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="请替换成你自己的随机字符串"

# ---- AI 答疑：OpenAI 兼容接口，任选一家，换厂只改这三行 ----
# deepseek  → https://api.deepseek.com/v1            deepseek-chat
# dashscope → https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
# zhipu     → https://open.bigmodel.cn/api/paas/v4   glm-4-flash
# moonshot  → https://api.moonshot.cn/v1             moonshot-v1-8k
# 留空 AI_API_KEY 则自动降级为内置的模拟回答（查词也会退到内置词库）
AI_PROVIDER="deepseek"
AI_API_KEY=""
AI_BASE_URL="https://api.deepseek.com/v1"
AI_MODEL="deepseek-chat"

# ---- WorkBuddy 云服务（AI 答疑主路：前端直调云端 LLM，无需自备 Key）----
# 公开配置默认写死在 src/lib/cloud-config.ts 的 CLOUD_PUBLIC_CONFIG（本项目实例），
# 以保证发布平台构建时读得到、不会出现「请求旧地址」。
# 给别人部署时，用下面两个构建期变量覆盖即可，无需改源码；不设置则回退到默认值。
# 注意：endpoint 是发布域名，云端按 Origin 精确匹配，域名不一致会落到 auth_ 错误。
# NEXT_PUBLIC_CLOUD_ENDPOINT="https://你的应用.app.workbuddy.host"
# NEXT_PUBLIC_CLOUD_PUBLISHABLE_KEY="wbpk_你的publishableKey"

# 完全不用 WorkBuddy 云时（改用下方 AI_API_KEY 跑 AI 答疑），设为 false：
# 云端不会被初始化，AI 答疑自动改走 /api/ai/chat（AI_API_KEY 路径），账号镜像同步也会跳过。
# NEXT_PUBLIC_CLOUD_ENABLED=false

# sharecode 透传：仅 workbuddy.host 网关需要（平台校验 ?sharecode / __wb_rsc，缺失返 403）。
# 部署到非 workbuddy.host 平台时设为 false，sharecode 不再拼到任何请求上，无副作用。
# NEXT_PUBLIC_SHARECODE_ENABLED=false

# 不用 WorkBuddy 云时，AI 答疑的真实模型由上方「AI 答疑：OpenAI 兼容接口」那组变量驱动
# （AI_API_KEY 等），填一个 Key 即可；留空则降级为内置演示回答。云端不可用时也会自动回退到这里。

# ---- 邮箱验证码（登录 / 注册）----
# 填了 RESEND_API_KEY 就真发信（Resend 免费额度够个人用，只要一个 Key，不需要 SMTP）；
# 留空则降级为「控制台回显」：验证码打到服务端日志，同时直接显示在登录页面上，
# 本地开发 / 演示环境照样能把注册登录流程走完，只是不经过邮箱。
# 申请地址：https://resend.com/api-keys
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# 发件人。用 Resend 必须先验证自己的域名；没验证时只能用 onboarding@resend.dev 给自己发。
# MAIL_FROM="左文右题 <no-reply@your-domain.com>"

# 没配 RESEND_API_KEY 时，是否也强制要求「注册必须带验证码」。
# 1 = 强制（页面流程本来就带码，这里只是把 API 直调也关掉）；0/留空 = 只校验带了的码。
# 注意：只要配了 RESEND_API_KEY，服务端会自动按 1 处理，不需要再设这个变量。
# EMAIL_CODE_REQUIRED=1
