# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# 本地排障时另开的构建目录（NEXT_DIST_DIR），绝不能随发布上传：
# 平台按 .gitignore 过滤上传，漏掉这几条会把 Windows 构建产物带进 Linux 沙箱
/.next-*/
/build-out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
prisma/dev.db
prisma/dev.db-journal

# ecdict 原始数据（太大，不进 git；精简版 offline-dict.json 会提交）
data/ecdict*
data/ecdict-raw/

# 截图（验证产物，不进 git）
/shots/
verify-out.txt

# 真题抓取缓存与写盘前备份（本地物料，几十 MB，不进 git）
/_sources/
/_backup/

# npm pack 产物
*.tgz

# 本地运行产物
.boot2.log
*.log
prisma/seed.db
prisma/*.db-journal
