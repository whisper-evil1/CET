// 数据模型 v2.0：四六级完整套卷系统。
// 说明：本地开发用 SQLite（零依赖，一条命令跑起来）。
// SQLite 不支持 Prisma 的 Json 原生类型，因此 JSON 字段统一用 String 存序列化文本，
// 由 src/lib/db-mappers.ts 负责 parse/stringify，业务层拿到的永远是强类型对象。
// 迁到 PostgreSQL 时：datasource.provider 改 postgresql，并把下列 String 字段改回 Json 即可。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  avatar    String?
  /// 用户目标级别，默认显示该级别的试卷
  targetLevel String? // CET4 | CET6
  createdAt DateTime @default(now())

  comments  Comment[]
  vocab     VocabWord[]
  favorites Favorite[]
  answers   Answer[]
  stats     UserStats[]
  checkins  Checkin[]
}

model Paper {
  id        String    @id @default(cuid())
  title     String
  level     String // CET4 | CET6
  year      Int?
  month     Int?
  totalTime Int       @default(130) // 总时长（分钟），四级125 六级130
  sort      Int       @default(0)
  sections  Section[]

  @@index([level, sort])
}

/// 试卷内的一个 Section（写作/听力/阅读/翻译）
model Section {
  id        String   @id @default(cuid())
  paperId   String
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  order     Int
  type      String   // writing | listening | reading | translation
  title     String   // 如 "Section A 短篇新闻"
  timeLimit Int?     // 该部分限时（分钟）
  passages  Passage[]

  @@index([paperId, order])
}

model Passage {
  id            String     @id @default(cuid())
  sectionId     String
  section       Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order         Int
  title         String?
  /// 阅读用：[{ label: "A", text: "..." }] 序列化后的 JSON 文本
  paragraphs    String     @default("[]")
  /// 听力用：/audio/xxx.mp3
  audioUrl      String?
  /// 听力音频时长（秒）
  audioDuration Int?
  /// 听力原文逐句带时间戳：[{ id: 1, start: 0.0, end: 4.2, text: "..." }]
  transcript    String?
  questions     Question[]

  @@index([sectionId, order])
}

model Question {
  id             String   @id @default(cuid())
  passageId      String
  passage        Passage  @relation(fields: [passageId], references: [id], onDelete: Cascade)
  order          Int
  number         Int      @default(0) // 卷面题号，如 41
  stem           String
  /// [{ key: "A", text: "..." }]
  options        String
  answer         String
  analysis       String
  /// { A: "为什么错", B: "..." }
  optionAnalysis String?
  evidencePara   String? // 阅读用：依据段落 label，如 "C"
  evidenceText   String? // 阅读用：依据原句，前端做高亮定位
  /// 听力用：答案出自原文第几句 [7, 8] 对应 transcript 里的 id
  evidenceSentences String?
  type           String? // 细节题 | 主旨题 | 推断题 | 词义题 | 态度题
  comments       Comment[]
  favorites      Favorite[]
  answers        Answer[]
  experiencePack ExperiencePack?

  @@index([passageId, order])
}

model Answer {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choice         String
  isCorrect      Boolean
  viewedAnalysis Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId, createdAt])
}

model Comment {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String
  visibility String    @default("private") // private | public
  parentId   String?
  parent     Comment?  @relation("Reply", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("Reply")
  likes      Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([questionId, visibility])
  @@index([userId])
}

model VocabWord {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word            String
  phonetic        String?
  /// [{ pos: "n.", zh: "..." }]
  definitions     String
  example         String?
  exampleZh       String?
  sourceContext   String?
  sourcePassageId String?
  reviewCount     Int      @default(0)
  correctStreak   Int      @default(0)
  status          String   @default("learning") // learning | mastered
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, word])
  @@index([userId, status])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId])
}

/// 词典结果缓存：同一单词只查一次，之后走本地库
model DictionaryEntry {
  id          String   @id @default(cuid())
  word        String   @unique
  phonetic    String?
  /// [{ pos: "n.", zh: "..." }]
  definitions String
  /// [{ en: "...", zh: "..." }]
  examples    String?
  source      String   @default("builtin") // builtin | ai | api | offline
  fetchedAt   DateTime @default(now())
}

/// 用户统计（按周/按月聚合，排行榜用）
model UserStats {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level         String   // CET4 | CET6
  periodType    String   // week | month
  periodKey     String   // 2026-W44 | 2026-10
  checkinDays   Int      @default(0)
  questionCount Int      @default(0)
  correctCount  Int      @default(0)
  accuracy      Float    @default(0)
  newVocab      Int      @default(0)
  totalScore    Float    @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([userId, level, periodType, periodKey])
  @@index([level, periodType, periodKey, totalScore])
}

/// 打卡记录
model Checkin {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  level         String
  questionCount Int      @default(0)

  @@unique([userId, date, level])
}

/// AI 自动生成的经验包（每题一条，缓存到数据库）
model ExperiencePack {
  id              String   @id @default(cuid())
  questionId      String   @unique
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  pitfall         String
  correctApproach String
  /// string[] 序列化
  commonMistakes  String
  /// string[] 序列化
  keyVocab        String
  basedOnCommentCount Int  @default(0)
  generatedAt     DateTime @default(now())
}
