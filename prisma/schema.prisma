// 数据模型：v1 阅读模块 + v2.0 套卷扩展。
// 说明：本地开发用 SQLite（零依赖，一条命令跑起来）。
// SQLite 不支持 Prisma 的 Json 原生类型，因此 JSON 字段统一用 String 存序列化文本，
// 由 src/lib/db-mappers.ts 负责 parse/stringify，业务层拿到的永远是强类型对象。
// 迁到 PostgreSQL 时：datasource.provider 改 postgresql，并把下列 String 字段改回 Json 即可。
//
// v2.0 扩展采用增量策略：保留 Paper→Passage→Question 的现有关系不破坏，
// 新增 Section 层级（Passage.sectionId 可选），音频/证据句/颜色字段都加成可选列，
// 这样 db push 是增量升级，线上已注册用户和作答数据不丢。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  avatar    String?
  createdAt DateTime @default(now())

  comments  Comment[]
  vocab     VocabWord[]
  favorites Favorite[]
  answers   Answer[]
  stats     UserStats[]
  checkins  Checkin[]
}

model Paper {
  id       String    @id @default(cuid())
  title    String
  level    String // CET4 | CET6
  year     Int?
  month    Int?
  totalTime Int? // 整套考试时长（分钟），考试模式用；PRD 定义 CET4=125 / CET6=130
  sort     Int       @default(0)
  passages Passage[]
  sections Section[]
}

// v2.0 新增：试卷内的一个 Section（写作/听力/阅读/翻译）。
// Passage 通过 sectionId 可选关联到 Section，老数据走 paperId，新数据走 sectionId。
model Section {
  id        String   @id @default(cuid())
  paperId   String
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  order     Int
  type      String // writing | listening | reading | translation
  title     String // 如 "Section A 短篇新闻"
  timeLimit Int?    // 该部分限时（分钟），考试模式用
  passages  Passage[]

  @@index([paperId, order])
}

model Passage {
  id         String     @id @default(cuid())
  paperId    String
  paper      Paper      @relation(fields: [paperId], references: [id], onDelete: Cascade)
  // v2.0 可选：走 Section 层级时填，老数据留空
  sectionId  String?
  section    Section?   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order      Int
  title      String?
  /// [{ label: "A", text: "..." }] 序列化后的 JSON 文本
  paragraphs String
  // v2.0 听力用：音频地址、时长、逐句原文
  audioUrl     String?
  audioDuration Int?
  /// [{ id:1, start:0.0, end:4.2, text:"..." }] 序列化 JSON
  transcript String?
  questions  Question[]

  @@index([paperId, order])
  @@index([sectionId])
}

model Question {
  id             String   @id @default(cuid())
  passageId      String
  passage        Passage  @relation(fields: [passageId], references: [id], onDelete: Cascade)
  order          Int
  number         Int      @default(0) // 卷面题号，如 41
  stem           String
  /// [{ key: "A", text: "..." }]
  options        String
  answer         String
  analysis       String
  /// { A: "为什么错", B: "..." }
  optionAnalysis String?
  evidencePara   String? // 依据段落 label，如 "C"
  evidenceText   String? // 依据原句，前端做高亮定位
  type           String? // 细节题 | 主旨题 | 推断题 | 词义题 | 态度题
  // v2.0 听力/阅读通用：答案出自原文第几句，序列化 JSON [7, 8]
  evidenceSentences String?
  // v2.0 答案颜色标注用
  correctColor   String   @default("#22c55e")
  wrongColor     String   @default("#ef4444")
  comments       Comment[]
  favorites      Favorite[]
  answers        Answer[]
  experiencePacks ExperiencePack[]

  @@index([passageId, order])
}

model Answer {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choice         String
  isCorrect      Boolean
  viewedAnalysis Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId, createdAt])
}

model Comment {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String
  visibility String    @default("private") // private | public
  parentId   String?
  parent     Comment?  @relation("Reply", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("Reply")
  likes      Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([questionId, visibility])
  @@index([userId])
}

model VocabWord {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word            String
  phonetic        String?
  /// [{ pos: "n.", zh: "..." }]
  definitions     String
  example         String?
  exampleZh       String?
  sourceContext   String?
  sourcePassageId String?
  reviewCount     Int      @default(0)
  correctStreak   Int      @default(0)
  status          String   @default("learning") // learning | mastered
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, word])
  @@index([userId, status])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId])
}

/// 词典结果缓存：同一单词只查一次，之后走本地库
model DictionaryEntry {
  id          String   @id @default(cuid())
  word        String   @unique
  phonetic    String?
  /// [{ pos: "n.", zh: "..." }]
  definitions String
  /// [{ en: "...", zh: "..." }]
  examples    String?
  source      String   @default("builtin") // builtin | ai | api
  fetchedAt   DateTime @default(now())
}

// v2.0 排行榜：用户按周/按月聚合的统计，页面加载直接读这里，不实时算全表
model UserStats {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level         String // CET4 | CET6
  periodType    String // week | month
  periodKey     String // 2026-W44 | 2026-10
  checkinDays   Int      @default(0)
  questionCount Int      @default(0)
  correctCount  Int      @default(0)
  accuracy      Float    @default(0)
  newVocab      Int      @default(0)
  totalScore    Float    @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([userId, level, periodType, periodKey])
  @@index([level, periodType, periodKey, totalScore])
}

// v2.0 打卡：当天做题 ≥5 道才算打卡，防刷分
model Checkin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SQLite 不支持 @db.Date，这里用 DateTime 存当天 00:00
  date      DateTime
  level     String
  questionCount Int  @default(0)

  @@unique([userId, date, level])
  @@index([userId, date])
}

// v2.0 AI 经验包：每题生成一次缓存，讨论数变化时标记刷新
model ExperiencePack {
  id              String   @id @default(cuid())
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  pitfall         String
  correctApproach String
  /// ["错误原因1", ...] 序列化 JSON
  commonMistakes  String
  /// ["生词1", ...] 序列化 JSON
  keyVocab        String
  basedOnCommentCount Int  @default(0)
  generatedAt     DateTime @default(now())

  @@unique([questionId])
}
